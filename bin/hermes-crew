#!/usr/bin/env bash
# hermes-crew: team messages, tasks, board and status for Hermes agent teams.
# Finds the hermes_crew package: $HERMES_CREW_LIB -> <checkout>/plugin/hermes-crew (when run from the repo)
# -> ${HERMES_HOME:-~/.hermes}/plugins/hermes-crew, and runs it with python3 (>= 3.10).
# The package goes onto sys.path, not PYTHONPATH: that would leak into the commands `verify`/`lock` run.
# real dir of this script, symlinks resolved portably (plain readlink: the GNU-only flag is missing on macOS)
_s=$0; while [ -L "$_s" ]; do _l=$(readlink "$_s"); case $_l in /*) _s=$_l ;; *) _s=$(dirname "$_s")/$_l ;; esac; done; HT_BIN=$(cd "$(dirname "$_s")" && pwd -P)
dir=""
for d in ${HERMES_CREW_LIB:+"$HERMES_CREW_LIB"} "$HT_BIN/../plugin/hermes-crew" "${HERMES_HOME:-$HOME/.hermes}/plugins/hermes-crew"; do
  if [ -f "$d/hermes_crew/cli.py" ]; then dir=$d; break; fi
done
# an empty dir = not found; python reports that, after its own version check (same order as before)
# shellcheck disable=SC2016  # the $VARs in the message are literal text
exec python3 -c 'import os, sys
if sys.version_info < (3, 10):
    sys.exit("hermes-crew needs Python >= 3.10 (this is %s)" % sys.version.split()[0])
d = sys.argv.pop(1)
if not d:
    sys.exit("hermes-crew: cannot find the hermes_crew package (looked in $HERMES_CREW_LIB, the checkout, "
             "${HERMES_HOME:-~/.hermes}/plugins/hermes-crew) - re-run install.sh")
if sys.path and sys.path[0] == "":  # -c puts the cwd first; a script run had its own (module-free) dir there
    del sys.path[0]
sys.path.insert(0, os.path.abspath(d))
from hermes_crew.cli import main
sys.exit(main())' "$dir" "$@"
