#!/usr/bin/env bash
# Split the lead's tmux window and start an interactive Hermes teammate with a role.
# usage: hermes-team-spawn [--model <model>] <Role> <role description...>
#        hermes-team-spawn --models                 models available for teammates
#        hermes-team-spawn --kill <Role>|--all
export PATH="$HOME/.local/bin:$PATH"
CONF="$HOME/.config/hermes-team.conf"; [ -f "$CONF" ] && . "$CONF"
if [ "$1" = "--models" ]; then
  if [ -n "${HERMES_TEAM_MODELS:-}" ]; then echo "$HERMES_TEAM_MODELS" | tr ' ' '\n'
  else echo "only the default model (set HERMES_TEAM_MODELS in $CONF to enable model diversity)"; fi
  exit 0
fi
my_pane() {  # the tmux pane whose process is an ancestor of this script
  local p=$$ id map; map=$(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null) || return 1
  while [ "${p:-1}" -gt 1 ]; do
    id=$(awk -v p="$p" '$1==p{print $2}' <<<"$map"); [ -n "$id" ] && { echo "$id"; return; }
    p=$(ps -o ppid= -p "$p" | tr -d ' ')
  done; return 1; }

LEAD=$(my_pane) || { echo "ERROR: Hermes is not running inside tmux. Ask the user to start it with 'hermes-wsl' (Windows) or 'hermes-tmux' (Linux/WSL)." >&2; exit 1; }
WIN=$(tmux display -p -t "$LEAD" '#{session_name}:#{window_index}')

if [ "$1" = "--kill" ]; then
  tmux list-panes -t "$WIN" -F '#{pane_id} #{@role}' | while read -r id role; do
    [ "$id" = "$LEAD" ] && continue
    if [ "$2" = "--all" ] || [ "${role,,}" = "${2,,}" ]; then tmux kill-pane -t "$id" && echo "stopped $role"; fi
  done
  tmux select-layout -t "$WIN" main-vertical >/dev/null; exit 0
fi

MODEL=""; [ "$1" = "--model" ] && { MODEL=$2; shift 2; }
[ $# -ge 2 ] || { echo "usage: hermes-team-spawn [--model <model>] <Role> <role description>" >&2; exit 2; }
ROLE=$(tr -c 'A-Za-z0-9_\n' '_' <<<"$1"); shift; DESC="$*"
[ -n "$(tmux display -p -t "$LEAD" '#{@role}')" ] || tmux set -p -t "$LEAD" @role lead
if tmux list-panes -t "$WIN" -F '#{@role}' | grep -qix "$ROLE"; then echo "teammate '$ROLE' already exists"; exit 0; fi

CWD=$(tmux display -p -t "$LEAD" '#{pane_current_path}')
[ -n "$(tmux show -wv -t "$WIN" @team_dir 2>/dev/null)" ] || tmux set -w -t "$WIN" @team_dir "$CWD"
TEAM_DIR=$(tmux show -wv -t "$WIN" @team_dir)
tmux set -w -t "$WIN" pane-border-status top
tmux set -w -t "$WIN" pane-border-format ' #{?@role,#{@role},#{pane_index}}#{?@model, (#{@model}),} '
CMD="hermes-shared${MODEL:+ -m $(printf '%q' "$MODEL")}"
NEW=$(tmux split-window -d -t "$LEAD" -c "$CWD" -P -F '#{pane_id}' "$CMD") || exit 1
tmux set -p -t "$NEW" @role "$ROLE"; [ -n "$MODEL" ] && tmux set -p -t "$NEW" @model "$MODEL"
tmux set -w -t "$WIN" main-pane-width 50%
tmux select-pane -t "$LEAD"; tmux select-layout -t "$WIN" main-vertical >/dev/null   # lead left, team stacked right

TEAM=$(tmux list-panes -t "$WIN" -F '#{@role}' | xargs)
BRIEF="You are $ROLE, a teammate in a Hermes agent team (other members: $TEAM; 'lead' orchestrates). Your role: $DESC -- Team directory: $TEAM_DIR. TEAM PROTOCOL: (1) Act on assignments from lead, and on teammates' requests that concern your assignment; otherwise wait. (2) Shared decisions: run 'hermes-team-board status' before producing anything that depends on names, interfaces, formats or numbers others also use; follow recorded decisions; record new ones with: hermes-team-board decide \"...\"; to change decision #N, agree it with lead, then record: hermes-team-board decide --replaces N \"...\" - never silently diverge. (3) Files: claim every file you author with: hermes-team-board own <file>. Never edit a file owned by someone else - message its owner with the exact change you need. (4) Reviews: read the actual current file, report concrete issues (file + section) to its owner; only when none remain run: hermes-team-board approve <file> \"<what you checked>\". Approvals auto-expire when the file changes. (5) Evidence: never claim a check, test or verification passed unless you actually ran it; otherwise write 'not verified'. (6) Messages: send only new information, requests or results - no thanks/acknowledgement-only messages. Messages show their send time; ignore ones already done or superseded. (7) Report results to lead with: hermes-team-msg lead \"...\". Reply 'ready' now."
hermes-team-msg "$NEW" "$BRIEF" >/dev/null
echo "spawned $ROLE${MODEL:+ ($MODEL)} in pane $NEW (brief queued; it starts in ~20s). Team: $TEAM. Board: $TEAM_DIR/.team/board.log"
