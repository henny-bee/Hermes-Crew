#!/usr/bin/env bash
# Split the lead's tmux window and start an interactive Hermes teammate with a role.
# usage: hermes-team-spawn [--model <model>] <Role> <role description...>
#        hermes-team-spawn --models                 models available for teammates
#        hermes-team-spawn --restart [--model M] <Role>   stop it gracefully, start it again (resumes its session)
#        hermes-team-spawn --kill <Role>|--all      graceful stop (/exit), kill after HERMES_TEAM_STOP_WAIT s (10)
# With the hermes-crew plugin installed and enabled the teammate gets a named, resumable session, its brief from
# .team/briefs/<Role>.md and mailbox delivery; without it the v2 path (brief typed into the pane) is used.
# HERMES_TEAM_MAX (default 6) limits the number of teammates.
export PATH="$HOME/.local/bin:$PATH"
CONF="$HOME/.config/hermes-team.conf"
# shellcheck disable=SC1090  # user config, not part of the repo
[ -f "$CONF" ] && . "$CONF"
if [ "$1" = "--models" ]; then
  if [ -n "${HERMES_TEAM_MODELS:-}" ]; then echo "$HERMES_TEAM_MODELS" | tr ' ' '\n'
  else echo "only the default model (set HERMES_TEAM_MODELS in $CONF to enable model diversity)"; fi
  exit 0
fi
# shellcheck source=/dev/null  # hermes-team-lib, next to this script
. "$(dirname "$(readlink -f "$0")")/hermes-team-lib"

LEAD=$(my_pane) || { echo "ERROR: Hermes is not running inside tmux. Ask the user to start it with 'hermes-wsl' (Windows) or 'hermes-tmux' (Linux/WSL)." >&2; exit 1; }
WIN=$(tmux display -p -t "$LEAD" '#{session_name}:#{window_index}')
SESSION=$(tmux display -p -t "$LEAD" '#{session_name}')
[ -n "$(tmux display -p -t "$LEAD" '#{@role}')" ] || tmux set -p -t "$LEAD" @role lead
CWD=$(tmux display -p -t "$LEAD" '#{pane_current_path}')
[ -n "$(team_dir_of "$WIN")" ] || tmux set -w -t "$WIN" @team_dir "$CWD"
TEAM_DIR=$(team_dir_of "$WIN"); ensure_team "$TEAM_DIR"
# v3 = plugin installed AND listed in plugins.enabled (same parse as `hermes-crew doctor`)
HHOME=${HERMES_HOME:-$HOME/.hermes}; V3=0; INSTALLED=0
if [ -f "$HHOME/plugins/hermes-crew/plugin.yaml" ]; then
  INSTALLED=1
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from hermes_crew.doctor import enabled_plugins
sys.exit("hermes-crew" not in enabled_plugins(open(sys.argv[2], errors="replace").read()))' \
    "$HHOME/plugins/hermes-crew" "$HHOME/config.yaml" 2>/dev/null && V3=1
fi
BRIEFS="$TEAM_DIR/.team/briefs"

teammates() { tmux list-panes -t "$WIN" -F '#{pane_id} #{@role}' | awk -v l="$LEAD" '$1!=l && $2!="" && tolower($2)!="lead"'; }  # never the lead or unlabelled panes
relayout() { tmux set -w -t "$WIN" main-pane-width "$(( $(tmux display -p -t "$WIN" '#{window_width}') / 2 ))"   # columns: "50%" needs tmux >= 3.3
  tmux select-pane -t "$LEAD"; tmux select-layout -t "$WIN" main-vertical >/dev/null; }   # lead left, team stacked right

stop_panes() {  # graceful: type /exit into every pane, wait, then kill what is still there
  local id alive
  for id in "$@"; do tmux send-keys -t "$id" -l '/exit'; tmux send-keys -t "$id" Enter; done
  for _ in $(seq $(( ${HERMES_TEAM_STOP_WAIT:-10} * 5 ))); do
    alive=0; for id in "$@"; do pane_exists "$id" && alive=1; done
    [ $alive = 0 ] && return; sleep 0.2
  done
  for id in "$@"; do tmux kill-pane -t "$id" 2>/dev/null; done; }

launch() {  # launch <Role> <model> <command>: new pane to the right, labelled; sets NEW
  NEW=$(tmux split-window -d -t "$LEAD" -c "$CWD" -P -F '#{pane_id}' "$3") || exit 1
  tmux set -p -t "$NEW" @role "$1"; [ -n "$2" ] && tmux set -p -t "$NEW" @model "$2"
  tmux set -w -t "$WIN" pane-border-status top
  tmux set -w -t "$WIN" pane-border-format ' #{?@role,#{@role},#{pane_index}}#{?@model, (#{@model}),} '
  relayout; }

hh() { [ -z "${HERMES_HOME:-}" ] || printf ' HERMES_HOME=%q' "$HERMES_HOME"; }   # panes get the tmux SERVER's env, so pass a custom HERMES_HOME explicitly

v3_cmd() {  # v3_cmd <Role> <model> <query file>: env tells the plugin who it is; the named session is resumable
  printf 'env HERMES_TEAM_DIR=%q HERMES_TEAM_ROLE=%q HERMES_CREW_SESSION=%q%s hermes-shared chat --cli -s hermes-tmux-teammate --continue %q --create-if-missing --query-file %q' \
    "$TEAM_DIR" "$1" "$SESSION" "$(hh)" "team-$(printf %s "$TEAM_DIR" | sha1sum | cut -c1-6)-$1" "$3"
  [ -z "$2" ] || printf ' -m %q' "$2"; }

case "$1" in
--kill)
  [ -n "$2" ] || { echo "usage: hermes-team-spawn --kill <Role>|--all" >&2; exit 2; }
  ids=(); names=()
  while read -r id role; do
    if [ "$2" = "--all" ] || [ "${role,,}" = "${2,,}" ]; then ids+=("$id"); names+=("$role"); fi
  done < <(teammates)
  if [ ${#ids[@]} -eq 0 ]; then [ "$2" = "--all" ] && exit 0; echo "no teammate '$2'" >&2; exit 1; fi
  stop_panes "${ids[@]}"; for r in "${names[@]}"; do echo "stopped $r"; done
  tmux select-layout -t "$WIN" main-vertical >/dev/null; exit 0 ;;
--restart)
  shift; MODEL=""; [ "$1" = "--model" ] && { MODEL=$2; shift 2; }
  [ -n "$1" ] || { echo "usage: hermes-team-spawn --restart [--model <model>] <Role>" >&2; exit 2; }
  [ $V3 = 1 ] || { echo "--restart needs the hermes-crew plugin installed and enabled (run install.sh): a v2 teammate has no session to resume" >&2; exit 1; }
  ROLE=$1; read -r id role < <(teammates | awk -v r="${ROLE,,}" 'tolower($2)==r')
  [ -n "$id" ] || [ -f "$BRIEFS/$ROLE.md" ] || { echo "no teammate '$ROLE'" >&2; exit 1; }
  [ -z "$role" ] || ROLE=$role
  [ -n "$MODEL" ] || { [ -f "$BRIEFS/$ROLE.model" ] && MODEL=$(<"$BRIEFS/$ROLE.model"); }
  [ -z "$id" ] || stop_panes "$id"
  printf 'You were restarted. Run hermes-crew status and hermes-crew task list --mine, then continue your work.\n' > "$BRIEFS/$ROLE.restart.md"
  launch "$ROLE" "$MODEL" "$(v3_cmd "$ROLE" "$MODEL" "$BRIEFS/$ROLE.restart.md")"
  echo "restarted $ROLE${MODEL:+ ($MODEL)} in pane $NEW (resumes session team-$(printf %s "$TEAM_DIR" | sha1sum | cut -c1-6)-$ROLE)"; exit 0 ;;
esac

MODEL=""; [ "$1" = "--model" ] && { MODEL=$2; shift 2; }
[ $# -ge 2 ] || { echo "usage: hermes-team-spawn [--model <model>] <Role> <role description>" >&2; exit 2; }
ROLE=$(tr -c 'A-Za-z0-9_\n' '_' <<<"$1"); shift; DESC="$*"
case "${ROLE,,}" in lead|user) echo "'$ROLE' is a reserved role name - pick another" >&2; exit 2 ;; esac
if [ -n "$MODEL" ] && [ -n "${HERMES_TEAM_MODELS:-}" ]; then
  case " $HERMES_TEAM_MODELS " in *" $MODEL "*) ;; *) echo "WARNING: model '$MODEL' is not in HERMES_TEAM_MODELS ($HERMES_TEAM_MODELS)" >&2 ;; esac
fi
if tmux list-panes -t "$WIN" -F '#{@role}' | grep -qix "$ROLE"; then echo "teammate '$ROLE' already exists"; exit 0; fi
MAX=${HERMES_TEAM_MAX:-6}
[ "$(teammates | wc -l)" -lt "$MAX" ] || { echo "REFUSED: the team already has $MAX teammates (HERMES_TEAM_MAX). Stop one with: hermes-team-spawn --kill <Role>" >&2; exit 1; }

if [ $V3 = 1 ]; then
  mkdir -p "$BRIEFS"; TEAM=$( { echo lead; teammates | awk '{print $2}'; echo "$ROLE"; } | xargs)
  cat > "$BRIEFS/$ROLE.md" <<BRIEF
You are $ROLE, a teammate in a Hermes agent team (members: $TEAM; 'lead' orchestrates).
Your role: $DESC
Team directory: $TEAM_DIR

Your team protocol is in the preloaded skill hermes-tmux-teammate. Use hermes-crew (status/send/task/verify/board).
Wait for your assignment from lead; it arrives automatically.
BRIEF
  [ -z "$MODEL" ] || printf '%s\n' "$MODEL" > "$BRIEFS/$ROLE.model"
  launch "$ROLE" "$MODEL" "$(v3_cmd "$ROLE" "$MODEL" "$BRIEFS/$ROLE.md")"
  echo "spawned $ROLE${MODEL:+ ($MODEL)} in pane $NEW (brief: $BRIEFS/$ROLE.md). Team: $TEAM. Board: $TEAM_DIR/.team/board.log"
  exit 0
fi

if [ $INSTALLED = 1 ]; then echo "WARNING: hermes-crew plugin is installed but not enabled: hermes plugins enable hermes-crew" >&2
else echo "WARNING: hermes-crew plugin not installed (run install.sh): messaging falls back to typing into panes" >&2; fi
launch "$ROLE" "$MODEL" "$(hh | sed 's/^ /env /;s/$/ /')hermes-shared --cli${MODEL:+ -m $(printf '%q' "$MODEL")}"
TEAM=$(tmux list-panes -t "$WIN" -F '#{@role}' | xargs)
BRIEF="You are $ROLE, a teammate in a Hermes agent team (other members: $TEAM; 'lead' orchestrates). Your role: $DESC -- Team directory: $TEAM_DIR. TEAM PROTOCOL: (1) Act on assignments from lead, and on teammates' requests that concern your assignment; otherwise wait. (2) Shared decisions: run 'hermes-team-board status' before producing anything that depends on names, interfaces, formats or numbers others also use; follow recorded decisions; record new ones with: hermes-team-board decide \"...\"; to change decision #N, agree it with lead, then record: hermes-team-board decide --replaces N \"...\" - never silently diverge. (3) Files: claim every file you author with: hermes-team-board own <file>. Never edit a file owned by someone else - message its owner with the exact change you need (to hand a file over: hermes-team-board transfer <file> <Role>). (4) Reviews: read the actual current file, report concrete issues (file + section) to its owner; only when none remain run: hermes-team-board approve <file> \"<what you checked>\". Approvals auto-expire when the file changes. (5) Evidence: never claim a check, test or verification passed unless you actually ran it; otherwise write 'not verified'. (6) Messages: send only new information, requests or results - no thanks/acknowledgement-only messages. Messages show their send time; ignore ones already done or superseded. (7) Report results to lead with: hermes-team-msg lead \"...\". Reply 'ready' now."
hermes-team-msg "$NEW" "$BRIEF" >/dev/null
echo "spawned $ROLE${MODEL:+ ($MODEL)} in pane $NEW (brief queued; it starts in ~20s). Team: $TEAM. Board: $TEAM_DIR/.team/board.log"
