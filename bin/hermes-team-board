#!/usr/bin/env bash
# Shared team board: an append-only log (<team dir>/.team/board.log) of decisions, file
# ownership and content-bound approvals. Role-agnostic: works for any team composition.
# usage:
#   hermes-team-board decide [--replaces <#>] "<decision>"   record (or replace) a shared decision
#   hermes-team-board own <file>...                         claim files you author
#   hermes-team-board approve <file> "<what you checked>"   approve the CURRENT content of a file
#   hermes-team-board status                                team, owners, decisions, approvals
# An approval stores the file's sha256; if the file changes later the approval shows STALE.
my_pane() {  # the tmux pane whose process is an ancestor of this script
  local p=$$ id map; map=$(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null) || return 1
  while [ "${p:-1}" -gt 1 ]; do
    id=$(awk -v p="$p" '$1==p{print $2}' <<<"$map"); [ -n "$id" ] && { echo "$id"; return; }
    p=$(ps -o ppid= -p "$p" | tr -d ' ')
  done; return 1; }

ME=$(my_pane); ROLE=${ME:+$(tmux display -p -t "$ME" '#{@role}')}; ROLE=${ROLE:-user}
WIN=${ME:+$(tmux display -p -t "$ME" '#{session_name}:#{window_index}')}
DIR=${WIN:+$(tmux show -wv -t "$WIN" @team_dir 2>/dev/null)}; DIR=${DIR:-$PWD}
LOG="$DIR/.team/board.log"; mkdir -p "$DIR/.team"
rel() { realpath -m --relative-to="$DIR" "$1"; }
clean() { tr '\t\n' '  ' <<<"$*"; }
append() { ( flock 9; printf '%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$ROLE" "$*" >> "$LOG" ) 9>"$LOG.lock"; }
owner_of() { awk -F'\t' -v f="$1" '$3=="OWN" && $4==f {o=$2} END{print o}' "$LOG" 2>/dev/null; }

case "$1" in
  decide)
    shift; rep=""; [ "$1" = "--replaces" ] && { rep=$2; shift 2; }
    [ -n "$*" ] || { echo "usage: hermes-team-board decide [--replaces <#>] \"<decision>\"" >&2; exit 2; }
    n=$(( $(grep -c '	DECIDE	' "$LOG" 2>/dev/null || echo 0) + 1 ))
    append "DECIDE	$(clean "$*")	${rep#\#}"; echo "decision #$n recorded${rep:+ (replaces #${rep#\#})}" ;;
  own)
    shift; [ $# -ge 1 ] || { echo "usage: hermes-team-board own <file>..." >&2; exit 2; }
    for f in "$@"; do
      r=$(rel "$f"); o=$(owner_of "$r")
      if [ -n "$o" ] && [ "$o" != "$ROLE" ]; then echo "REFUSED: $r is owned by $o - ask $o (or lead) to transfer it" >&2; exit 1; fi
      append "OWN	$r"; echo "$ROLE owns $r"
    done ;;
  approve)
    shift; f=$1; shift; ev=$(clean "$*")
    [ -f "$f" ] || { echo "usage: hermes-team-board approve <existing file> \"<what you checked>\"" >&2; exit 2; }
    [ ${#ev} -ge 20 ] || { echo "REFUSED: describe what you actually checked (at least a sentence)" >&2; exit 1; }
    r=$(rel "$f"); o=$(owner_of "$r")
    [ "$o" = "$ROLE" ] && { echo "REFUSED: you own $r - an approval must come from someone else" >&2; exit 1; }
    h=$(sha256sum "$f" | cut -c1-12)
    append "APPROVE	$r	$h	$ev"; echo "approved $r @ $h" ;;
  status)
    echo "== team ($DIR) =="
    if [ -n "$WIN" ]; then
      tmux list-panes -t "$WIN" -F '#{pane_id} #{@role} #{@model}' | while read -r id r m; do
        line=$(tmux capture-pane -p -t "$id" | grep '❯' | tail -1)
        st=busy; [[ "$line" == "❯ "* && "$line" != *"msg=interrupt"* ]] && st=idle
        printf '  %-18s %-5s model=%s\n' "${r:-?}" "$st" "${m:-default}"
      done
    fi
    [ -f "$LOG" ] || { echo "(board is empty)"; exit 0; }
    echo "== decisions (current; replaced ones hidden) =="
    awk -F'\t' '$3=="DECIDE"{n++; t[n]=substr($1,12); w[n]=$2; d[n]=$4; if($5!="") gone[$5]=n}
      END{for(i=1;i<=n;i++) if(!(i in gone)) printf "  #%d [%s %s] %s\n", i, t[i], w[i], d[i]}' "$LOG"
    echo "== files =="
    awk -F'\t' '$3=="OWN"{o[$4]=$2} $3=="APPROVE"{a[$4","$2]=$5; ev[$4","$2]=$6; who[$4]=who[$4]" "$2} END{for(f in o) print f"\t"o[f]; for(k in a){split(k,x,","); print "A\t"x[1]"\t"x[2]"\t"a[k]"\t"ev[k]}}' "$LOG" > "$LOG.view"
    awk -F'\t' '$1!="A"' "$LOG.view" | sort | while IFS=$'\t' read -r f o; do
      cur=$( [ -f "$DIR/$f" ] && sha256sum "$DIR/$f" | cut -c1-12 || echo missing )
      printf '  %-40s owner=%-16s\n' "$f" "$o"
      ok=0
      while IFS=$'\t' read -r _ af ar ah aev; do
        [ "$af" = "$f" ] || continue
        if [ "$ah" = "$cur" ]; then s=OK; ok=1; else s="STALE (file changed after approval)"; fi
        printf '      approved by %-14s %s - %s\n' "$ar" "$s" "${aev:0:90}"
      done < <(awk -F'\t' '$1=="A"' "$LOG.view")
      [ $ok = 1 ] || echo "      !! no valid approval from a non-owner"
    done
    rm -f "$LOG.view" ;;
  *) sed -n '2,9p' "$0"; exit 2 ;;
esac
