@@ -0,0 +1,128 @@
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+import app
+import migrate_config
+
+
+class TestConfigMigration(unittest.TestCase):
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir)
+
+    def test_migrate_config_success(self):
+        ini_content = """[server]
+host = 192.168.1.10
+port = 5000
+debug = yes
+
+[database]
+url = postgresql://user:pass@localhost:5432/testdb
+"""
+        ini_path = os.path.join(self.test_dir, "test.ini")
+        json_path = os.path.join(self.test_dir, "test.json")
+
+        with open(ini_path, "w", encoding="utf-8") as f:
+            f.write(ini_content)
+
+        data = migrate_config.migrate(ini_path, json_path)
+
+        self.assertTrue(os.path.exists(json_path))
+        self.assertEqual(data["host"], "192.168.1.10")
+        self.assertEqual(data["port"], 5000)
+        self.assertIsInstance(data["port"], int)
+        self.assertEqual(data["db_url"], "postgresql://user:pass@localhost:5432/testdb")
+        self.assertIs(data["debug"], True)
+
+        with open(json_path, "r", encoding="utf-8") as f:
+            loaded = json.load(f)
+        self.assertEqual(loaded, data)
+
+    def test_migrate_config_does_not_overwrite(self):
+        ini_path = os.path.join(self.test_dir, "test.ini")
+        json_path = os.path.join(self.test_dir, "test.json")
+
+        with open(ini_path, "w", encoding="utf-8") as f:
+            f.write("[server]\nhost = 127.0.0.1\n")
+
+        with open(json_path, "w", encoding="utf-8") as f:
+            f.write('{"existing": true}')
+
+        with self.assertRaises(FileExistsError):
+            migrate_config.migrate(ini_path, json_path)
+
+        with open(json_path, "r", encoding="utf-8") as f:
+            content = f.read()
+        self.assertEqual(content, '{"existing": true}')
+
+    def test_migrate_defaults_when_ini_empty(self):
+        ini_path = os.path.join(self.test_dir, "empty.ini")
+        json_path = os.path.join(self.test_dir, "empty.json")
+
+        with open(ini_path, "w", encoding="utf-8") as f:
+            f.write("")
+
+        data = migrate_config.migrate(ini_path, json_path)
+        self.assertEqual(
+            data,
+            {
+                "host": "127.0.0.1",
+                "port": 8000,
+                "db_url": "sqlite:///app.db",
+                "debug": False,
+            },
+        )
+
+    def test_app_load_config_json(self):
+        json_path = os.path.join(self.test_dir, "app_config.json")
+        cfg_data = {
+            "host": "0.0.0.0",
+            "port": 9000,
+            "db_url": "mysql://root@db/main",
+            "debug": True,
+        }
+        with open(json_path, "w", encoding="utf-8") as f:
+            json.dump(cfg_data, f)
+
+        loaded = app.load_config(json_path)
+        self.assertEqual(loaded, cfg_data)
+        self.assertIsInstance(loaded["port"], int)
+        self.assertIsInstance(loaded["debug"], bool)
+
+    def test_app_load_config_defaults_missing_file(self):
+        missing_path = os.path.join(self.test_dir, "nonexistent.json")
+        loaded = app.load_config(missing_path)
+        self.assertEqual(
+            loaded,
+            {
+                "host": "127.0.0.1",
+                "port": 8000,
+                "db_url": "sqlite:///app.db",
+                "debug": False,
+            },
+        )
+
+    def test_app_load_config_defaults_missing_keys(self):
+        json_path = os.path.join(self.test_dir, "partial.json")
+        with open(json_path, "w", encoding="utf-8") as f:
+            json.dump({"host": "10.0.0.1"}, f)
+
+        loaded = app.load_config(json_path)
+        self.assertEqual(
+            loaded,
+            {
+                "host": "10.0.0.1",
+                "port": 8000,
+                "db_url": "sqlite:///app.db",
+                "debug": False,
+            },
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
